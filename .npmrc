# Project lives under ~/Desktop, which macOS iCloud Drive ("Desktop & Documents
# Folders" sync) actively manages. pnpm's default `package-import-method` on APFS
# hard-links node_modules files from its content-addressable store
# (~/Library/pnpm/store) -- a hard link means the node_modules copy and the store
# copy are the same bytes on disk. When iCloud evicts/re-materializes files under
# Desktop in the background, it mutates that shared data, corrupting the pnpm
# store itself (confirmed via `pnpm store status` flagging ~90 unrelated packages
# as "modified" after a plain dev launch). Forcing a real copy instead of a hard
# link fully isolates the store from anything iCloud does to this folder, at the
# cost of some extra disk space and slightly slower installs.
package-import-method=copy
